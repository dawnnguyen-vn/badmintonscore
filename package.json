{
  "name": "badmintonscore",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint \"src/**/*.ux\"",
    "lint:style:fix": "stylelint \"src/**/*.ux\" --fix",
    "format": "prettier --write \"src/**/*.{ux,js,json}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ux,js,json}\" \"*.js\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ux": [
      "stylelint --fix",
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "aiot-toolkit": "^2.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
