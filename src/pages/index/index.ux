<template>
  <!-- Full-screen scoreboard. Gestures are bound to the root. -->
  <div class="page" onswipe="onSwipe" onlongpress="onRestart">

    <div class="board" if="{{ !editing }}">
    <!-- Player B (top, orange) -->
    <div class="zone zoneB">
      <text class="score scoreB" onclick="onEditB">{{ scoreB }}</text>
    </div>

    <!-- Badminton court: dot = server's service court, ring = receiver's -->
    <div class="court">
      <div class="courtRow">
        <div class="cell cellLeft {{ courtDots.TL }}">
          <div class="dot dotA" if="{{ courtDots.TL === 'sa' }}"></div>
          <div class="dot dotB" if="{{ courtDots.TL === 'sb' }}"></div>
          <div class="ring" if="{{ courtDots.TL === 'r' }}"></div>
        </div>
        <div class="cell cellRight {{ courtDots.TR }}">
          <div class="dot dotA" if="{{ courtDots.TR === 'sa' }}"></div>
          <div class="dot dotB" if="{{ courtDots.TR === 'sb' }}"></div>
          <div class="ring" if="{{ courtDots.TR === 'r' }}"></div>
        </div>
      </div>
      <div class="net">
        <text class="netTime">{{ time }}</text>
      </div>
      <div class="courtRow">
        <div class="cell cellLeft {{ courtDots.BL }}">
          <div class="dot dotA" if="{{ courtDots.BL === 'sa' }}"></div>
          <div class="dot dotB" if="{{ courtDots.BL === 'sb' }}"></div>
          <div class="ring" if="{{ courtDots.BL === 'r' }}"></div>
        </div>
        <div class="cell cellRight {{ courtDots.BR }}">
          <div class="dot dotA" if="{{ courtDots.BR === 'sa' }}"></div>
          <div class="dot dotB" if="{{ courtDots.BR === 'sb' }}"></div>
          <div class="ring" if="{{ courtDots.BR === 'r' }}"></div>
        </div>
      </div>
    </div>

    <!-- Player A (bottom, blue) -->
    <div class="zone zoneA">
      <text class="score scoreA" onclick="onEditA">{{ scoreA }}</text>
    </div>
    </div>

    <!-- Hint strip (doubles as game-point / winner status line) -->
    <div class="hint" if="{{ !editing }}">
      <text class="hintText {{ statusClass }}" if="{{ winner || gamePoint }}">{{ statusText }}</text>
      <text class="hintText" if="{{ !winner && !gamePoint }}">up B+ · down A+ · left undo · hold reset</text>
    </div>

    <!-- Edit overlay -->
    <div class="overlay" if="{{ editing }}">
      <text class="ovTitle">Edit {{ editing }}</text>
      <div class="ovRow">
        <text class="ovBtn" onclick="onDec">-</text>
        <text class="ovVal">{{ editing === 'A' ? scoreA : scoreB }}</text>
        <text class="ovBtn" onclick="onInc">+</text>
      </div>
      <text class="ovDone" onclick="onDone">Done</text>
    </div>

  </div>
</template>

<script>
export default {
  private: {
    scoreA: 0,
    scoreB: 0,
    server: "A", // who serves: 'A' or 'B'
    editing: "", // '' | 'A' | 'B'
    history: [],
    time: "",
    timer: 0
  },

  computed: {
    // Top-down court. Boxes: TL/TR = player B's service courts (top half),
    // BL/BR = player A's (bottom half). A player serves from their RIGHT
    // court on an even score, LEFT on odd. From the map's viewpoint B (top,
    // facing down) has right=TL, left=TR; A (bottom, facing up) has right=BR,
    // left=BL. The receiver stands in the diagonally-opposite service court.
    courtDots() {
      // Per-box code: '' | 'sa' (A serves here, blue dot) | 'sb' (B serves
      // here, orange dot) | 'r' (receiver, ring).
      const boxes = { TL: "", TR: "", BL: "", BR: "" }
      // Fresh game (0-0): either side may serve first, so mark both possible
      // service courts. A would serve from BR (even), B from TL (even).
      if (this.scoreA === 0 && this.scoreB === 0) {
        boxes.BR = "sa"
        boxes.TL = "sb"
        return boxes
      }
      let serverBox
      if (this.server === "A") {
        serverBox = this.scoreA % 2 === 0 ? "BR" : "BL"
      } else {
        serverBox = this.scoreB % 2 === 0 ? "TL" : "TR"
      }
      const diag = { TL: "BR", BR: "TL", TR: "BL", BL: "TR" }
      boxes[serverBox] = this.server === "A" ? "sa" : "sb"
      boxes[diag[serverBox]] = "r"
      return boxes
    },

    // Which side, if any, has won: to 21 with a 2-point lead, or the
    // 29-all cap where 30 wins outright. '' | 'A' | 'B'.
    winner() {
      if (this._won(this.scoreA, this.scoreB)) {
        return "A"
      }
      if (this._won(this.scoreB, this.scoreA)) {
        return "B"
      }
      return ""
    },

    // Side(s) that would win by scoring one more point. '' | 'A' | 'B' |
    // 'AB' (both, only possible at 29-all).
    gamePoint() {
      if (this.winner) {
        return ""
      }
      const a = this._won(this.scoreA + 1, this.scoreB)
      const b = this._won(this.scoreB + 1, this.scoreA)
      if (a && b) {
        return "AB"
      }
      if (a) {
        return "A"
      }
      if (b) {
        return "B"
      }
      return ""
    },

    // Status line shown in the hint strip during game point / after a win.
    statusText() {
      if (this.winner) {
        const w = this.winner === "A" ? this.scoreA : this.scoreB
        const l = this.winner === "A" ? this.scoreB : this.scoreA
        return "★ " + this.winner + " WINS  " + w + "-" + l
      }
      if (this.gamePoint === "AB") {
        return "● GAME POINT"
      }
      if (this.gamePoint) {
        return "● GAME POINT " + this.gamePoint
      }
      return ""
    },

    // Colour for the status line: winner/game-point side, else neutral.
    statusClass() {
      const who = this.winner || this.gamePoint
      if (who === "A") {
        return "cA"
      }
      if (who === "B") {
        return "cB"
      }
      return "cWhite"
    }
  },

  onReady() {
    this.updateTime()
    this.timer = setInterval(() => {
      this.updateTime()
    }, 15000)
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
    }
  },

  updateTime() {
    const d = new Date()
    const hh = ("0" + d.getHours()).slice(-2)
    const mm = ("0" + d.getMinutes()).slice(-2)
    this.time = hh + ":" + mm
  },

  // A side with score `s` (opponent `o`) has won the game.
  _won(s, o) {
    return (s >= 21 && s - o >= 2) || s >= 30
  },

  pushHistory() {
    this.history.push({
      scoreA: this.scoreA,
      scoreB: this.scoreB,
      server: this.server
    })
  },

  addPoint(side) {
    // Game's over — swipes no longer add points (undo/reset/edit still work).
    if (this.winner) {
      return
    }
    this.pushHistory()
    // Winner of the rally becomes the server.
    if (side === "A") {
      this.scoreA = this.scoreA + 1
      this.server = "A"
    } else {
      this.scoreB = this.scoreB + 1
      this.server = "B"
    }
  },

  undo() {
    if (this.history.length === 0) {
      return
    }
    const prev = this.history.pop()
    this.scoreA = prev.scoreA
    this.scoreB = prev.scoreB
    this.server = prev.server
  },

  onSwipe(e) {
    if (this.editing) {
      return
    }
    const d = e.direction
    if (d === "up") {
      this.addPoint("B")
    } else if (d === "down") {
      this.addPoint("A")
    } else if (d === "left") {
      this.undo()
    }
  },

  onRestart() {
    if (this.editing) {
      return
    }
    this.pushHistory()
    this.scoreA = 0
    this.scoreB = 0
    this.server = "A"
  },

  onEditA() {
    this.pushHistory()
    this.editing = "A"
  },

  onEditB() {
    this.pushHistory()
    this.editing = "B"
  },

  onInc() {
    if (this.editing === "A") {
      this.scoreA = this.scoreA + 1
    } else {
      this.scoreB = this.scoreB + 1
    }
  },

  onDec() {
    if (this.editing === "A") {
      if (this.scoreA > 0) {
        this.scoreA = this.scoreA - 1
      }
    } else {
      if (this.scoreB > 0) {
        this.scoreB = this.scoreB - 1
      }
    }
  },

  onDone() {
    this.editing = ""
  }
}
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  align-items: center;
  justify-content: center;
}

.board {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding-top: 36px;
  padding-bottom: 6px;
}

.zone {
  width: 100%;
  justify-content: center;
  align-items: center;
}

.score {
  font-size: 150px;
  line-height: 150px;
  font-weight: bold;
  text-align: center;
}

.scoreA {
  color: #2ea6dc;
}

.scoreB {
  color: #f26522;
}

/* Middle serve / court indicator */
/* Badminton court diagram */
.court {
  flex-direction: column;
  width: 150px;
  margin-top: 10px;
  margin-bottom: 10px;
}

.courtRow {
  flex-direction: row;
  width: 100%;
  height: 40px;
  border-width: 2px;
  border-color: #5a5a5a;
  background-color: #0a0a0a;
}

.cell {
  flex: 1;
  justify-content: center;
  align-items: center;
}

.cellLeft {
  border-right-width: 2px;
  border-right-color: #5a5a5a;
}

.cellRight {
  border-left-width: 2px;
  border-left-color: #5a5a5a;
}


.sa {
  background-color: #0f1a22;
}

.sb {
  background-color: #221408;
}

.r {
  background-color: #262010;
}

.dot {
  width: 16px;
  height: 16px;
  border-radius: 8px;
}

.dotA {
  background-color: #2ea6dc;
}

.dotB {
  background-color: #f26522;
}

.ring {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  border-width: 2px;
  border-color: #e0b23c;
  background-color: #00000000;
}

.net {
  width: 100%;
  height: 30px;
  justify-content: center;
  align-items: center;
}

.netTime {
  font-size: 28px;
  color: #cccccc;
}

.hint {
  width: 100%;
  height: 30px;
  justify-content: center;
  align-items: center;
}

.hintText {
  font-size: 13px;
  color: #555555;
  text-align: center;
}

/* Status-line colours (game point / winner). Defined after .hintText so
   they override its dim colour when both classes are on the element. */
.cA {
  font-size: 15px;
  color: #2ea6dc;
}

.cB {
  font-size: 15px;
  color: #f26522;
}

.cWhite {
  font-size: 15px;
  color: #ffffff;
}

/* Edit overlay */
.overlay {
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #000000;
}

.ovTitle {
  font-size: 26px;
  color: #ffffff;
  margin-bottom: 24px;
}

.ovRow {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ovBtn {
  width: 60px;
  height: 60px;
  font-size: 40px;
  color: #ffffff;
  text-align: center;
  background-color: #222222;
  border-radius: 30px;
}

.ovVal {
  width: 90px;
  font-size: 56px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

.ovDone {
  margin-top: 30px;
  width: 140px;
  height: 46px;
  font-size: 22px;
  color: #000000;
  background-color: #2ea6dc;
  border-radius: 23px;
  text-align: center;
}
</style>
