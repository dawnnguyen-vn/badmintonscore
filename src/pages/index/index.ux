<template>
  <!-- Full-screen scoreboard. Swipes are bound to the root; double taps are
       per-area (score zone = edit that score, court band = menu). Nothing
       binds `longpress`, so the system's own long-press panel (the one with
       the app's remove button) still comes up on the watch. -->
  <div class="page" onswipe="onSwipe">
    <div class="board" if="{{ !editing && !confirming && !menu && !showWinner }}">
      <!-- Player B (top, orange) -->
      <div class="zone zoneB" onclick="onTapB">
        <text class="score scoreB">{{ scoreB }}</text>
      </div>

      <!-- Double-tapping the band between the two scores opens the menu; the
           court diagram inside it shows the serve situation: dot = server's
           service court, ring = receiver's. -->
      <div class="mid" onclick="onTapMid">
        <div class="court">
          <div class="courtRow">
            <div class="cell cellLeft {{ courtDots.TL }}">
              <div class="dot dotA" if="{{ courtDots.TL === 'sa' }}"></div>
              <div class="dot dotB" if="{{ courtDots.TL === 'sb' }}"></div>
              <div class="ring" if="{{ courtDots.TL === 'r' }}"></div>
            </div>
            <div class="cell cellRight {{ courtDots.TR }}">
              <div class="dot dotA" if="{{ courtDots.TR === 'sa' }}"></div>
              <div class="dot dotB" if="{{ courtDots.TR === 'sb' }}"></div>
              <div class="ring" if="{{ courtDots.TR === 'r' }}"></div>
            </div>
          </div>
          <div class="net">
            <text class="netTime">{{ time }}</text>
          </div>
          <div class="courtRow">
            <div class="cell cellLeft {{ courtDots.BL }}">
              <div class="dot dotA" if="{{ courtDots.BL === 'sa' }}"></div>
              <div class="dot dotB" if="{{ courtDots.BL === 'sb' }}"></div>
              <div class="ring" if="{{ courtDots.BL === 'r' }}"></div>
            </div>
            <div class="cell cellRight {{ courtDots.BR }}">
              <div class="dot dotA" if="{{ courtDots.BR === 'sa' }}"></div>
              <div class="dot dotB" if="{{ courtDots.BR === 'sb' }}"></div>
              <div class="ring" if="{{ courtDots.BR === 'r' }}"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Player A (bottom, blue) -->
      <div class="zone zoneA" onclick="onTapA">
        <text class="score scoreA">{{ scoreA }}</text>
      </div>
    </div>

    <!-- Status line (empty unless it is game point) -->
    <div class="hint" if="{{ !editing && !confirming && !menu && !showWinner }}">
      <text class="hintText {{ statusClass }}" if="{{ gamePoint }}">{{ statusText }}</text>
    </div>

    <!-- Edit overlay -->
    <div class="overlay" if="{{ editing }}">
      <div class="ovMain">
        <text class="ovTitle">Edit {{ editing }}</text>
        <div class="ovRow">
          <text class="ovBtn" onclick="onDec">-</text>
          <text class="ovVal">{{ editing === "A" ? scoreA : scoreB }}</text>
          <text class="ovBtn" onclick="onInc">+</text>
        </div>
      </div>
      <text class="ovDone ovDoneBottom" onclick="onDone">Done</text>
    </div>

    <!-- Action menu (double tap the court band) -->
    <div class="overlay" if="{{ menu }}">
      <div class="ovMain">
        <text class="ovTitle">Menu</text>
        <text class="menuBtn" onclick="onMenuReset">Reset game</text>
        <text class="menuBtn menuExit" onclick="onMenuExit">Exit app</text>
      </div>
      <text class="winBack" onclick="onCloseMenu">cancel</text>
    </div>

    <!-- Reset confirm overlay -->
    <div class="overlay" if="{{ confirming }}">
      <div class="ovMain">
        <text class="ovTitle">Reset game?</text>
        <text class="ovSub">{{ scoreB }} - {{ scoreA }}</text>
        <text class="ovDanger" onclick="onConfirmReset">Reset</text>
      </div>
      <text class="winBack" onclick="onCancelReset">cancel</text>
    </div>

    <!-- Winner overlay -->
    <div class="overlay" if="{{ showWinner }}">
      <div class="ovMain">
        <text class="winTitle {{ statusClass }}">★ {{ winner }} WINS</text>
        <text class="winScore">{{ winScore }}</text>
        <text class="ovDone ovDoneSpaced" onclick="onNewGame">New Game</text>
      </div>
      <text class="winBack" onclick="onDismissWinner">back</text>
    </div>
  </div>
</template>

<script>
import app from "@system.app"
import router from "@system.router"
import storage from "@system.storage"

// Module scope, not viewModel data: constants and helpers here cost one
// allocation for the life of the app, while anything on `private` gets a
// change observer and anything built inside a method is re-allocated on every
// call. See the memory checklist in the README.
const SAVE_KEY = "game" // storage key, holds "scoreA,scoreB,server"
const HISTORY_MAX = 40 // undo depth; keeps a long match from growing forever
const DOUBLE_TAP_MS = 350 // two taps on one zone this close count as a double
const BACK_GUARD_MS = 700 // one physical swipe can reach us twice, see onSwipe
// Service court diagonally opposite each service court.
const DIAG = {TL: "BR", BR: "TL", TR: "BL", BL: "TR"}

function onStorageFail(data, code) {
  console.log("storage failed, code = " + code)
}

export default {
  private: {
    scoreA: 0,
    scoreB: 0,
    server: "A", // who serves: 'A' or 'B'
    editing: "", // '' | 'A' | 'B'
    confirming: false, // reset-confirm overlay is up
    menu: false, // action menu (reset / exit) is up
    winnerDismissed: false, // user dismissed the winner overlay to fix a score
    time: ""
    // Non-UI state (`_history`, `_timer`, the back/tap timestamps) is kept off
    // `private` so the framework doesn't attach change observers to it — see
    // onInit().
  },

  computed: {
    // Top-down court. Boxes: TL/TR = player B's service courts (top half),
    // BL/BR = player A's (bottom half). A player serves from their RIGHT
    // court on an even score, LEFT on odd. From the map's viewpoint B (top,
    // facing down) has right=TL, left=TR; A (bottom, facing up) has right=BR,
    // left=BL. The receiver stands in the diagonally-opposite service court.
    courtDots() {
      // Per-box code: '' | 'sa' (A serves here, blue dot) | 'sb' (B serves
      // here, orange dot) | 'r' (receiver, ring).
      const boxes = {TL: "", TR: "", BL: "", BR: ""}
      // Fresh game (0-0): either side may serve first, so mark both possible
      // service courts. A would serve from BR (even), B from TL (even).
      if (this.scoreA === 0 && this.scoreB === 0) {
        boxes.BR = "sa"
        boxes.TL = "sb"
        return boxes
      }
      let serverBox
      if (this.server === "A") {
        serverBox = this.scoreA % 2 === 0 ? "BR" : "BL"
      } else {
        serverBox = this.scoreB % 2 === 0 ? "TL" : "TR"
      }
      boxes[serverBox] = this.server === "A" ? "sa" : "sb"
      boxes[DIAG[serverBox]] = "r"
      return boxes
    },

    // Which side, if any, has won: to 21 with a 2-point lead, or the
    // 29-all cap where 30 wins outright. '' | 'A' | 'B'.
    winner() {
      if (this._won(this.scoreA, this.scoreB)) {
        return "A"
      }
      if (this._won(this.scoreB, this.scoreA)) {
        return "B"
      }
      return ""
    },

    // Side(s) that would win by scoring one more point. '' | 'A' | 'B' |
    // 'AB' (both, only possible at 29-all).
    gamePoint() {
      if (this.winner) {
        return ""
      }
      const a = this._won(this.scoreA + 1, this.scoreB)
      const b = this._won(this.scoreB + 1, this.scoreA)
      if (a && b) {
        return "AB"
      }
      if (a) {
        return "A"
      }
      if (b) {
        return "B"
      }
      return ""
    },

    // Winner overlay is up: someone has won and the user hasn't dismissed it
    // (dismissing lets them undo/edit a mis-scored final point).
    showWinner() {
      return (
        !!this.winner && !this.winnerDismissed && !this.editing && !this.confirming && !this.menu
      )
    },

    // Final score, winner's points first.
    winScore() {
      if (!this.winner) {
        return ""
      }
      const w = this.winner === "A" ? this.scoreA : this.scoreB
      const l = this.winner === "A" ? this.scoreB : this.scoreA
      return w + " - " + l
    },

    // Status line shown in the hint strip during game point.
    statusText() {
      if (this.gamePoint === "AB") {
        return "● GAME POINT"
      }
      if (this.gamePoint) {
        return "● GAME POINT " + this.gamePoint
      }
      return ""
    },

    // Colour for the status line: winner/game-point side, else neutral.
    statusClass() {
      const who = this.winner || this.gamePoint
      if (who === "A") {
        return "cA"
      }
      if (who === "B") {
        return "cB"
      }
      return "cWhite"
    }
  },

  onInit() {
    this._history = [] // undo stack, never rendered
    this._timer = 0 // clock interval id
    this._lastBack = 0 // timestamp of the last handled back, see handleBack()
    this._sysBack = false // onBackPress() has fired at least once
    this._tapAt = 0 // first tap of a possible double tap, see doubleTap()
    this._tapZone = "" // ...and which zone it landed on
    this.restore()
  },

  onReady() {
    this.startClock()
  },

  // The clock only has to tick while the page is on screen.
  onShow() {
    this.startClock()
  },

  onHide() {
    this.stopClock()
  },

  onDestroy() {
    this.stopClock()
    // One collection on the way out, never on a hot path — a frequent runGC()
    // stutters the page.
    if (typeof global !== "undefined" && global.runGC) {
      global.runGC()
    }
  },

  // The whole game state as one short string. Both the undo stack and
  // storage use this format, so neither has to hold an object per entry.
  encode() {
    return this.scoreA + "," + this.scoreB + "," + this.server
  },

  // Apply a string that encode() produced. A value that isn't one leaves the
  // board untouched.
  decode(raw) {
    const parts = ("" + raw).split(",")
    if (parts.length === 3) {
      const a = parseInt(parts[0], 10)
      const b = parseInt(parts[1], 10)
      // NaN fails every comparison, so a corrupt value changes nothing.
      if (a >= 0 && a < 100 && b >= 0 && b < 100) {
        this.scoreA = a
        this.scoreB = b
        this.server = parts[2] === "B" ? "B" : "A"
      }
    }
    parts.length = 0 // release the parsed data as soon as it is consumed
  },

  // Reading the score back is what makes leaving cheap: swipe out by accident
  // and the match is still there when the app reopens.
  restore() {
    storage.get({
      key: SAVE_KEY,
      default: "",
      success: (raw) => {
        // A point scored before the read lands wins over the stored value.
        if (this._history.length === 0) {
          this.decode(raw)
        }
      },
      fail: onStorageFail
    })
  },

  // Called after every score change. The value is one short string, so a write
  // per rally is cheap; `onStorageFail` is module-level so no closure is built
  // here either.
  save() {
    storage.set({
      key: SAVE_KEY,
      value: this.encode(),
      fail: onStorageFail
    })
  },

  startClock() {
    this.updateTime()
    if (this._timer) {
      return
    }
    this._timer = setInterval(() => {
      this.updateTime()
    }, 15000)
  },

  stopClock() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = 0
    }
  },

  updateTime() {
    const d = new Date()
    const hh = ("0" + d.getHours()).slice(-2)
    const mm = ("0" + d.getMinutes()).slice(-2)
    this.time = hh + ":" + mm
  },

  // A side with score `s` (opponent `o`) has won the game.
  _won(s, o) {
    return (s >= 21 && s - o >= 2) || s >= 30
  },

  pushHistory() {
    // Bounded on purpose: undo past HISTORY_MAX points is not worth the memory.
    if (this._history.length >= HISTORY_MAX) {
      this._history.shift()
    }
    this._history.push(this.encode())
  },

  addPoint(side) {
    // Game's over — swipes no longer add points (undo/reset/edit still work).
    if (this.winner) {
      return
    }
    this.pushHistory()
    // Winner of the rally becomes the server.
    if (side === "A") {
      this.scoreA = this.scoreA + 1
      this.server = "A"
    } else {
      this.scoreB = this.scoreB + 1
      this.server = "B"
    }
    this.save()
  },

  undo() {
    if (this._history.length === 0) {
      return
    }
    this.decode(this._history.pop())
    // Back in a playable state — allow the winner overlay to show again.
    this.winnerDismissed = false
    this.save()
  },

  // Clear the score for a fresh game.
  resetGame() {
    this.pushHistory()
    this.scoreA = 0
    this.scoreB = 0
    this.server = "A"
    this.winnerDismissed = false
    this.save()
  },

  onSwipe(e) {
    const d = e.direction
    // Right is the system back gesture. It has to be handled here too, because
    // on some builds the page swallows it and onBackPress() never fires. Where
    // onBackPress() *does* fire, one physical swipe arrives twice — so once
    // we've seen it work, right-swipes are left to it and ignored here.
    if (d === "right") {
      if (!this._sysBack) {
        this.handleBack()
      }
      return
    }
    // Any overlay is up — scoring gestures are ignored.
    if (this.editing || this.confirming || this.menu || this.showWinner) {
      return
    }
    if (d === "up") {
      this.addPoint("B")
    } else if (d === "down") {
      this.addPoint("A")
    } else if (d === "left") {
      this.undo()
    }
  },

  // Board actions are on a double tap, not a long press: `longpress` has to
  // stay unbound so the watch's own long-press panel (with the app's remove
  // button) still opens. Two taps on the same zone within 350ms count; a
  // single tap does nothing, so a stray touch mid-rally is ignored.
  doubleTap(zone) {
    const now = Date.now()
    if (zone === this._tapZone && now - this._tapAt < DOUBLE_TAP_MS) {
      // Consume the pair so a third tap starts over instead of re-firing.
      this._tapZone = ""
      this._tapAt = 0
      return true
    }
    this._tapZone = zone
    this._tapAt = now
    return false
  },

  onTapMid() {
    if (this.doubleTap("mid")) {
      this.menu = true
    }
  },

  onCloseMenu() {
    this.menu = false
  },

  onMenuReset() {
    this.menu = false
    this.confirming = true
  },

  onMenuExit() {
    this.menu = false
    this.exitApp()
  },

  // Close the app and go back to the watch. Returns true when it was handled
  // here, false when the caller should let the system's own back run instead.
  exitApp() {
    try {
      if (app && typeof app.terminate === "function") {
        app.terminate()
        return true
      }
    } catch (e) {
      console.log("app.terminate failed: " + e)
    }
    // Fallback for platforms without @system.app: a single-page app closes
    // when the entry page is popped. Report it as unhandled so a back press
    // also falls through to the system default.
    router.back()
    return false
  },

  // The one place that decides what "back" does, shared by the right-swipe
  // gesture and the system back key. Returning true means "handled, don't
  // leave".
  handleBack() {
    // Belt and braces for the very first press, before _sysBack is known.
    const now = Date.now()
    if (now - this._lastBack < BACK_GUARD_MS) {
      return true
    }
    this._lastBack = now
    // Topmost overlay closes first.
    if (this.editing) {
      this.onDone()
      return true
    }
    if (this.confirming) {
      this.confirming = false
      return true
    }
    if (this.menu) {
      this.menu = false
      return true
    }
    if (this.showWinner) {
      this.winnerDismissed = true
      return true
    }
    // Nothing left to close: leave. There is no "are you sure?" — the score is
    // in storage, so coming straight back picks the match up where it was.
    return this.exitApp()
  },

  onBackPress() {
    this._sysBack = true
    return this.handleBack()
  },

  onCancelReset() {
    this.confirming = false
  },

  onConfirmReset() {
    this.resetGame()
    this.confirming = false
  },

  onNewGame() {
    this.resetGame()
  },

  onDismissWinner() {
    // Hide the overlay so the board is reachable to undo/edit a mis-score.
    this.winnerDismissed = true
  },

  // Double tap on a score zone. The board is only rendered with no overlay up,
  // so no guard is needed here.
  onTapA() {
    if (this.doubleTap("A")) {
      this.pushHistory()
      this.editing = "A"
    }
  },

  onTapB() {
    if (this.doubleTap("B")) {
      this.pushHistory()
      this.editing = "B"
    }
  },

  onInc() {
    if (this.editing === "A") {
      this.scoreA = this.scoreA + 1
    } else {
      this.scoreB = this.scoreB + 1
    }
  },

  onDec() {
    if (this.editing === "A") {
      if (this.scoreA > 0) {
        this.scoreA = this.scoreA - 1
      }
    } else {
      if (this.scoreB > 0) {
        this.scoreB = this.scoreB - 1
      }
    }
  },

  onDone() {
    this.editing = ""
    // Re-show the winner overlay if the edited score is now a win.
    this.winnerDismissed = false
    this.save()
  }
}
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background-color: #000;
}

.board {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding-top: 36px;
  padding-bottom: 6px;
}

.zone {
  align-items: center;
  justify-content: center;
  width: 100%;
}

.score {
  font-size: 150px;
  font-weight: bold;
  line-height: 150px;
  text-align: center;
}

.scoreA {
  color: #2ea6dc;
}

.scoreB {
  color: #f26522;
}

/* Middle serve / court indicator */

/* Badminton court diagram */
.mid {
  flex: 1;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.court {
  flex-direction: column;
  width: 150px;
  margin-top: 10px;
  margin-bottom: 10px;
}

.courtRow {
  flex-direction: row;
  width: 100%;
  height: 40px;
  background-color: #0a0a0a;
  border-color: #5a5a5a;
  border-width: 2px;
}

.cell {
  flex: 1;
  align-items: center;
  justify-content: center;
}

.cellLeft {
  border-right-color: #5a5a5a;
  border-right-width: 2px;
}

.cellRight {
  border-left-color: #5a5a5a;
  border-left-width: 2px;
}

.sa {
  background-color: #0f1a22;
}

.sb {
  background-color: #221408;
}

.r {
  background-color: #262010;
}

.dot {
  width: 16px;
  height: 16px;
  border-radius: 8px;
}

.dotA {
  background-color: #2ea6dc;
}

.dotB {
  background-color: #f26522;
}

.ring {
  width: 16px;
  height: 16px;
  background-color: #0000;
  border-color: #e0b23c;
  border-width: 2px;
  border-radius: 8px;
}

.net {
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 30px;
}

.netTime {
  font-size: 28px;
  color: #ccc;
}

.hint {
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 30px;
}

.hintText {
  font-size: 13px;
  color: #555;
  text-align: center;
}

/* Status-line colours (game point / winner). Defined after .hintText so
   they override its dim colour when both classes are on the element. */
.cA {
  font-size: 15px;
  color: #2ea6dc;
}

.cB {
  font-size: 15px;
  color: #f26522;
}

.cWhite {
  font-size: 15px;
  color: #fff;
}

/* Edit overlay */
.overlay {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  background-color: #000;
}

/* The actions, centred in everything the escape row leaves over. Splitting the
   overlay this way pushes `cancel` to the bottom edge instead of sitting it a
   fixed margin below the buttons — on a 212px-wide screen that margin was
   close enough to mis-tap. */
.ovMain {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.ovTitle {
  margin-bottom: 24px;
  font-size: 26px;
  color: #fff;
}

.ovRow {
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ovBtn {
  width: 56px;
  height: 56px;
  font-size: 40px;
  color: #fff;
  text-align: center;
  background-color: #222;
  border-radius: 30px;
}

.ovVal {
  width: 84px;
  font-size: 56px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* Primary action. Same 170px as .menuBtn so every button on the watch is one
   size and one target. Positioning is split out below. */
.ovDone {
  width: 170px;
  height: 46px;
  font-size: 22px;
  color: #000;
  text-align: center;
  background-color: #2ea6dc;
  border-radius: 23px;
}

/* Inside .ovMain, below content that needs clearing. */
.ovDoneSpaced {
  margin-top: 24px;
}

/* Sits low but well clear of the bottom edge - 14px put it into the display's
   curved corner region, where it was awkward to tap. Only the edit overlay
   uses this, so raising it does not move `cancel` on the other screens. */
.ovDoneBottom {
  margin-bottom: 48px;
}

/* Action menu. 20px between the buttons, not 12: two 46px targets that close on
   a 212px screen were easy to mis-tap, and pinning `cancel` to the bottom of
   the overlay freed up the space. */
.menuBtn {
  width: 170px;
  height: 46px;
  margin-bottom: 20px;
  font-size: 20px;
  color: #fff;
  text-align: center;
  background-color: #222;
  border-radius: 23px;
}

.menuExit {
  color: #f26522;
}

/* Reset-confirm overlay */
.ovSub {
  margin-bottom: 30px;
  font-size: 40px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

/* Destructive action, stacked rather than beside cancel: two 110px buttons
   plus margins came to 244px, wider than the 212px screen, and it put "Reset"
   a thumb-width from "Cancel". */
.ovDanger {
  width: 170px;
  height: 46px;
  font-size: 20px;
  color: #fff;
  text-align: center;
  background-color: #c02828;
  border-radius: 23px;
}

/* Winner overlay */
.winTitle {
  margin-bottom: 10px;
  font-size: 34px;
  font-weight: bold;
  text-align: center;
}

.winScore {
  margin-bottom: 10px;
  font-size: 64px;
  font-weight: bold;
  color: #fff;
  text-align: center;
}

.winBack {
  /* Separation now comes from .ovMain filling the space above, so this only
     needs to stay clear of the very bottom edge. */
  margin-bottom: 14px;
  font-size: 16px;
  color: #666;
  text-align: center;
}
</style>
